/-- Both the row totals and all prescribed weight marginals are checked in Lean. -/
private theorem finite_checks : ∀ u : Fin 21,
    let t := u.val + 1
    entry (table (2*t) (finiteRows t)) 0 = factorial (t+1) ∧
    ∀ a : Fin (t+1), entry (table t (finiteRows t)) a.val =
      factorial a.val * factorial (t-a.val) := by decide

theorem array_through_21 (t : Nat) (lo : 1 ≤ t) (hi : t ≤ 21) :
    ExactBinaryArray (fun w => entry (finiteRows t) (wordWeight w))
      (factorial (t+1)) t (2*t) := by
  obtain ⟨u, hu⟩ : ∃ u : Fin 21, u.val+1 = t := ⟨⟨t-1, by omega⟩, by simp; omega⟩
  have hc := finite_checks u
  dsimp only at hc
  rw [hu] at hc
  apply array_of_table (finiteRows t) (by omega)
  · exact hc.1
  · simpa [show 2*t-t=t by omega] using hc.2

end Excess
